# Copie para .env (ou configure no painel da hospedagem)
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=gnnordeste.com.br,www.gnnordeste.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=https://gnnordeste.com.br,https://www.gnnordeste.com.br
# true = o Django serve /media/ (simples); false = servido pelo Nginx/Apache
DJANGO_SERVE_MEDIA=true

# E-mail (opcional) — para receber os formulários por e-mail
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.gmail.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=gruponordesteservicos@gmail.com
# DJANGO_EMAIL_HOST_PASSWORD=senha-de-app
